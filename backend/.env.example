# 白泽平台后端环境变量示例（复制为 .env 并填写）
PROJECT_NAME=Baize Platform
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=baize
POSTGRES_PASSWORD=baize
POSTGRES_DB=baize
# 或直接使用完整连接串（优先）：
# DATABASE_URL=postgresql+asyncpg://baize:baize@localhost:5432/baize

SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

CORS_ORIGINS=http://localhost:5173
